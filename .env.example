# Keep the app off public interfaces.
LISTEN_ADDR=127.0.0.1:3000

# External issue images and audio used by local development.
EXTERNAL_MEDIA_DIR=../galata-dergisi-static-assets/server-assets/public

# Mounted read-only by the Docker preview.
GALATA_MEDIA_ROOT=../../../galata-dergisi-static-assets/server-assets/public

# Change this if the local TLS port is busy.
GALATA_PREVIEW_HTTPS_PORT=44443
