# Dependencies and tool caches
/node_modules/
/.npm/
/.eslintcache
/coverage/
/.nyc_output/
__pycache__/
*.py[cod]

# Local environment and editor files
.env*
!.env.example
/.vscode/
.DS_Store
*.log
npm-debug.log*

# Generated application and test outputs
/build/
/public/
/.static-assets/
/internal/site/dist/*
/release/
/zap-reports/
/client/images/carousel-thumbnail-placeholders.webp

# Local magazine media; canonical media lives in the static-assets repository
/client/audio/
*.mp3
*.ogg

# Operational secrets and generated deployment credentials
/ops/**/*.env
/ops/**/*.key
/ops/**/*.pem
/ops/**/*known_hosts*
/ops/**/*deploy-key*

# Protected historical/private material; never commit these archives or secrets
/config.js
*.sql
/sql-backups/
/database-exports/
/contributions/
/uploads/
/credentials.json
/token.json
