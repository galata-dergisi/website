# syntax=docker/dockerfile:1

FROM nginx:stable-alpine

RUN apk add --no-cache openssl \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p \
        /etc/nginx/ssl-certs/galatadergisi.org \
        /etc/nginx/snippets \
        /var/log/nginx/galatadergisi.org

# Start from the tunnel-oriented production virtual host. The preview replaces
# the hostname and loopback HTTP listener, then adds preview-only TLS.
COPY ops/nginx/galata-shared.conf /etc/nginx/conf.d/00-galata-shared.conf
COPY ops/nginx/galata-security-headers.conf /etc/nginx/snippets/galata-security-headers.conf
COPY ops/nginx/galata-production-csp.conf /etc/nginx/snippets/galata-production-csp.conf
COPY ops/nginx/galatadergisi.org.conf /etc/nginx/conf.d/galatadergisi.org.conf
COPY ops/local-production/preview-tls.conf /etc/nginx/snippets/galata-preview-tls.conf

RUN sed -i \
        -e '/^[[:space:]]*server_name /c\  server_name localhost;' \
        -e '/^[[:space:]]*if (\$host /c\  if ($host != localhost) {' \
        /etc/nginx/conf.d/galatadergisi.org.conf \
    && awk ' \
        /^[[:space:]]*listen 127[.]0[.]0[.]1:8080;/ { \
          print "  listen 443 ssl;"; \
          print "  ssl_certificate /etc/nginx/ssl-certs/galatadergisi.org/public.pem;"; \
          print "  ssl_certificate_key /etc/nginx/ssl-certs/galatadergisi.org/private.pem;"; \
          print "  include /etc/nginx/snippets/galata-preview-tls.conf;"; \
          next; \
        } \
        { print } \
      ' /etc/nginx/conf.d/galatadergisi.org.conf \
        > /tmp/galatadergisi.org.conf \
    && mv /tmp/galatadergisi.org.conf /etc/nginx/conf.d/galatadergisi.org.conf \
    && openssl req -x509 -nodes -newkey rsa:2048 -sha256 -days 3650 \
        -subj '/CN=localhost' \
        -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' \
        -keyout /etc/nginx/ssl-certs/galatadergisi.org/private.pem \
        -out /etc/nginx/ssl-certs/galatadergisi.org/public.pem \
    && chmod 0600 /etc/nginx/ssl-certs/galatadergisi.org/private.pem \
    && ln -sf /dev/stderr /var/log/nginx/galatadergisi.org/error.log \
    && nginx -t

EXPOSE 443
