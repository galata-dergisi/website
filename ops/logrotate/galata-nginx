/var/log/nginx/galatadergisi.org/error.log /var/log/nginx/dev.galatadergisi.org/error.log {
  daily
  rotate 30
  maxage 30
  missingok
  notifempty
  compress
  delaycompress
  dateext
  create 0640 www-data adm
  sharedscripts
  postrotate
    if [ -s /run/nginx.pid ]; then
      kill -USR1 "$(cat /run/nginx.pid)"
    fi
  endscript
}
