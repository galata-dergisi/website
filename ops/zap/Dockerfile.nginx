# syntax=docker/dockerfile:1

FROM nginx:stable-alpine

RUN rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p \
        /etc/nginx/snippets \
        /var/log/nginx/galatadergisi.org \
        /var/log/nginx/dev.galatadergisi.org \
        /var/www/galatadergisi.org/public/images \
        /var/www/galatadergisi.org/public/audio \
        /var/www/dev.galatadergisi.org/public

COPY ops/nginx/galata-shared.conf /etc/nginx/conf.d/00-galata-shared.conf
COPY ops/nginx/galata-security-headers.conf /etc/nginx/snippets/galata-security-headers.conf
COPY ops/nginx/galata-production-csp.conf /etc/nginx/snippets/galata-production-csp.conf
COPY ops/nginx/galata-dev-csp.conf /etc/nginx/snippets/galata-dev-csp.conf
COPY ops/nginx/galatadergisi.org.conf /etc/nginx/conf.d/galatadergisi.org.conf
COPY ops/nginx/dev.galatadergisi.org.conf /etc/nginx/conf.d/dev.galatadergisi.org.conf

# Validate both deployed vhosts and every snippet together. The dev vhost is
# removed after validation; ZAP receives only the production vhost, whose
# listener is changed solely for the private Compose network.
RUN sed -i \
      's/listen 127[.]0[.]0[.]1:8080;/listen 8080;/' \
      /etc/nginx/conf.d/galatadergisi.org.conf \
      /etc/nginx/conf.d/dev.galatadergisi.org.conf \
    && ln -sf /dev/stderr /var/log/nginx/galatadergisi.org/error.log \
    && ln -sf /dev/stderr /var/log/nginx/dev.galatadergisi.org/error.log \
    && nginx -t \
    && rm /etc/nginx/conf.d/dev.galatadergisi.org.conf \
    && nginx -t

EXPOSE 8080
